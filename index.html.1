let cart = [];

function addToCart(name, price){

cart.push({
name:name,
price:price
});

updateCart();
}

function updateCart(){

let cartList =
document.getElementById("cart-list");

let total =
document.getElementById("total");

cartList.innerHTML = "";

let sum = 0;

cart.forEach(item=>{

let li =
document.createElement("li");

li.innerText =
item.name + " - ৳" + item.price;

cartList.appendChild(li);

sum += item.price;

});

total.innerText =
"Total: ৳" + sum;
}
